{
    "name": "ayarse/who-icd-api-php",
    "description": "PHP SDK for the WHO ICD API, built with Saloon. Provides access to ICD-11 Foundation, Linearization, and ICD-10 endpoints.",
    "keywords": ["who", "icd", "icd-11", "icd-10", "api", "sdk", "saloon", "laravel", "healthcare", "medical-coding"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "saloonphp/saloon": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "WhoIcd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WhoIcd\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WhoIcd\\WhoIcdServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
